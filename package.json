{
  "name": "waveger",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @waveger/web dev",
    "dev:native": "pnpm --filter @waveger/native start",
    "build": "pnpm --filter @waveger/web build",
    "db:migrate": "pnpm --filter @waveger/db migrate",
    "openapi": "pnpm --filter @waveger/api openapi",
    "lint": "eslint .",
    "typecheck": "pnpm -r --parallel typecheck",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:"
  }
}
