{
  "openapi": "3.1.0",
  "info": {
    "title": "Waveger API",
    "version": "v1",
    "description": "The one API behind both Waveger apps. Evolves additively: routes and fields are added, never removed or repurposed. Any path this document does not list answers 404 in the same ApiError envelope every failure below uses."
  },
  "components": {
    "schemas": {
      "ApiStatus": {
        "type": "object",
        "properties": {
          "service": {
            "type": "string",
            "enum": [
              "waveger-api"
            ]
          },
          "version": {
            "type": "string",
            "enum": [
              "v1"
            ]
          },
          "database": {
            "type": "object",
            "properties": {
              "reachable": {
                "type": "boolean",
                "enum": [
                  true
                ]
              },
              "migrations": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "reachable",
              "migrations"
            ]
          }
        },
        "required": [
          "service",
          "version",
          "database"
        ]
      },
      "ApiError": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "error",
          "message"
        ]
      },
      "ChartWeek": {
        "type": "object",
        "properties": {
          "chart": {
            "type": "object",
            "properties": {
              "slug": {
                "type": "string"
              },
              "name": {
                "type": "string"
              }
            },
            "required": [
              "slug",
              "name"
            ]
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "entries": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ChartEntry"
            }
          },
          "exits": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ChartExit"
            }
          }
        },
        "required": [
          "chart",
          "date",
          "entries",
          "exits"
        ]
      },
      "ChartEntry": {
        "type": "object",
        "properties": {
          "position": {
            "type": "integer",
            "exclusiveMinimum": 0
          },
          "title": {
            "type": "string"
          },
          "artist": {
            "type": "string"
          },
          "peakPosition": {
            "type": "integer"
          },
          "weeksOnChart": {
            "type": "integer"
          },
          "movement": {
            "$ref": "#/components/schemas/ChartMovement"
          }
        },
        "required": [
          "position",
          "title",
          "artist",
          "peakPosition",
          "weeksOnChart",
          "movement"
        ]
      },
      "ChartMovement": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "moved"
                ]
              },
              "positionsGained": {
                "type": "integer"
              }
            },
            "required": [
              "kind",
              "positionsGained"
            ]
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "non-mover"
                ]
              }
            },
            "required": [
              "kind"
            ]
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "debut"
                ]
              }
            },
            "required": [
              "kind"
            ]
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "unknown"
                ]
              }
            },
            "required": [
              "kind"
            ]
          }
        ]
      },
      "ChartExit": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "artist": {
            "type": "string"
          },
          "previousPosition": {
            "type": "integer",
            "exclusiveMinimum": 0
          }
        },
        "required": [
          "title",
          "artist",
          "previousPosition"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/api/v1/status": {
      "get": {
        "tags": [
          "Service"
        ],
        "summary": "Service and database status",
        "description": "Confirms the API is running, that it can reach Postgres, and which migrations that database has had applied.",
        "responses": {
          "200": {
            "description": "The service is up and the database is reachable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiStatus"
                }
              }
            }
          },
          "500": {
            "description": "Something else failed. Always the same error envelope.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "503": {
            "description": "The service is up but the database is not reachable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/chart-weeks/latest": {
      "get": {
        "tags": [
          "Charts"
        ],
        "summary": "The most recently held Chart Week",
        "description": "The most recently published Chart Week Waveger holds, as a ranked list from Position 1 down, with each Entry's movement since the previous Chart Week and the Songs that left it. Served from Waveger's own archive: reading it never reaches back to the Chart Compiler. Public and unauthenticated.",
        "responses": {
          "200": {
            "description": "The whole Chart Week, in Position order, with its exits. Movement is `unknown` throughout when Waveger holds no previous Chart Week.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChartWeek"
                }
              }
            }
          },
          "404": {
            "description": "Waveger holds no Chart Week at all. An empty archive rather than a missing path, so a client can say so instead of rendering nothing.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    }
  },
  "webhooks": {}
}
